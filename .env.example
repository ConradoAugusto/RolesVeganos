# Copie este arquivo para .env (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase (Project Settings > API). A "anon key" é pública: quem protege os dados são as regras do schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço da tela de login oculta (padrão: /acesso).
VITE_ROTA_LOGIN=/acesso
